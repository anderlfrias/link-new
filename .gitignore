# Dependencies
node_modules/

# Backend build output
backend/dist/

# Frontend (Next.js) build output
frontend/.next/
frontend/out/

# Environment variables: ningún .env real entra al repo, en ningún nivel.
# Solo se versionan los .env.example.
.env
.env.*
!.env.example

# Claves y certificados
*.pem
*.key

# Prisma generated client
backend/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db

backend/uploads/*
!backend/uploads/.gitkeep

# Test coverage output
backend/coverage/
frontend/coverage/

# Salida local de graphify (grafo de conocimiento del código): se genera en
# cada máquina y guarda rutas absolutas locales.
graphify-out/

# Scripts y datos auxiliares de demostración local (no versionados)
demo-seed/
