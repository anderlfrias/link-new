# Copiar a .env.local para desarrollo (`npm run dev`).
# Las NEXT_PUBLIC_* se embeben en el bundle al hacer `next build`: cambiarlas
# requiere volver a construir el frontend.

# URL base de la API del backend (incluye el prefijo /api).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# URL del servidor de Socket.IO (el mismo backend, sin /api).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Opcional, solo desarrollo: hosts extra (sin protocolo ni puerto, separados
# por coma) desde los que se puede abrir el servidor de desarrollo, por ejemplo
# la IP de tu máquina en la red local para probar desde otro dispositivo.
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.10
