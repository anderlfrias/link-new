{
  "name": "link",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "prisma:sync": "npm run prisma:sync --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=backend",
    "db:baseline": "npm run db:baseline --workspace=backend",
    "start": "concurrently \"npm:start:backend\" \"npm:start:frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "version:sync": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
