# Cadena de conexión a PostgreSQL usada por Prisma (ver prisma.config.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/chat_interno?schema=public"

# URL base del microservicio EXTERNAL_AUTH (sin el sufijo /v1/login)
EXTERNAL_AUTH_API_URL="https://external-auth.example.com"
# Código de esta aplicación registrado en EXTERNAL_AUTH
APP_CODE_EXTERNAL_AUTH="chat-interno"
# Secreto compartido para verificar los JWT emitidos por EXTERNAL_AUTH (HS256)
EXTERNAL_AUTH_JWT_SECRET="change-me"

# Tamaño máximo (en MB) de un archivo adjunto. Opcional, default 25.
MAX_UPLOAD_SIZE_MB=25
