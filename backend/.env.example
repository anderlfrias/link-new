# Copiar a backend/.env para correr el backend sin Docker (`npm run dev`).
# Para docker compose, ver el .env.example de la raíz del repo.

# Cadena de conexión a PostgreSQL usada por Prisma (ver prisma.config.ts).
# Coincide con el contenedor de `docker compose up -d postgres` (usuario,
# contraseña y base "link"); ajustala si usás otro servidor.
DATABASE_URL="postgresql://link:link@localhost:5432/link?schema=public"

# Puerto HTTP y de Socket.IO. Opcional, default 4000.
PORT=4000

# Autenticación (ver README.md, sección "Autenticación"). El modo se deduce de
# estas variables:
#   - con las tres EXTERNAL_AUTH_* definidas -> modo "external-auth": se inicia sesión con EXTERNAL_AUTH
#   - sin ninguna EXTERNAL_AUTH_*            -> modo "local": cuentas administradas en
#                                       esta plataforma (requiere LOCAL_AUTH_JWT_SECRET)
#   - con solo una o dos             -> el server no arranca (configuración incompleta)
# Una variable vacía cuenta como no definida.

# --- Modo external-auth ---
# URL base del servicio EXTERNAL_AUTH (sin el sufijo /v1/login), ej. https://external-auth.example.com
EXTERNAL_AUTH_API_URL=""
# Código de esta aplicación registrado en EXTERNAL_AUTH
APP_CODE_EXTERNAL_AUTH=""
# Secreto compartido para verificar los JWT emitidos por EXTERNAL_AUTH (HS256)
EXTERNAL_AUTH_JWT_SECRET=""

# --- Modo local ---
# Las cuentas y sus contraseñas viven en esta base. El primer admin se crea con
# `npm run auth:admin -- create-admin --email <correo>` (ver src/modules/auth/README.md).
# Secreto para firmar los tokens de sesión de las cuentas locales (HS256), de
# 32 caracteres o más. En modo external-auth se ignora. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LOCAL_AUTH_JWT_SECRET=""

# Tamaño máximo (en MB) de un archivo adjunto. Opcional, default 2048.
# Solo usado como semilla de AppSettings.maxUploadSizeMb en el primer
# arranque. Los archivos de más de 32 MB solo se pueden subir con
# almacenamiento S3 (STORAGE_WRITE_PROVIDER=S3, subida por partes): con
# almacenamiento en disco (LOCAL) el máximo efectivo es 32 MB, sin importar
# este valor.
MAX_UPLOAD_SIZE_MB=2048

# Web Push (notificaciones con la app/pestaña cerrada). OBLIGATORIAS: con
# claves inválidas el server no arranca. Generar un par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: o https: de contacto, requerido por la spec de Web Push.
VAPID_SUBJECT="mailto:admin@example.com"

# Origen(es) permitidos para la API HTTP y el socket (separados por coma si
# son varios). OBLIGATORIA con NODE_ENV=production: sin definir, el server no
# arranca. "*" acepta cualquier origen, a propósito. Fuera de producción, sin
# definir también acepta cualquier origen (cómodo en dev/LAN).
CORS_ORIGIN="http://localhost:3000"

# Reverse proxy (ver SECURITY.md). Valor de `trust proxy` de Express:
#   1      un proxy delante del backend (nginx, Caddy, Cloudflare Tunnel). Default.
#   2      dos proxies encadenados (ej. Cloudflare → nginx → backend).
#   false  backend expuesto directo, sin proxy. Con 1 y sin proxy, cualquier
#          cliente elige su IP mandando X-Forwarded-For.
TRUST_PROXY=1
# true solo si TODO el tráfico entra por Cloudflare: toma la IP del cliente de
# la cabecera CF-Connecting-IP. Sin Cloudflare delante, cualquiera puede
# mandarla y saltarse el rate limiting.
TRUST_CF_CONNECTING_IP=false

# GIFs y stickers vía GIPHY. Deshabilitado por defecto: sin definir, /v1/giphy/*
# responde 503 y el frontend oculta las pestañas de GIFs y stickers.
# Antes de definirla, leer src/modules/giphy/README.md ("Requisitos de GIPHY"):
# la integración actual no sigue varias pautas de la documentación de GIPHY.
GIPHY_API_KEY=""

# Secreto para firmar tokens HMAC en URLs de descarga de archivos.
# Opcional: sin definir, se usa el secreto JWT del modo activo como fallback
# (EXTERNAL_AUTH_JWT_SECRET o LOCAL_AUTH_JWT_SECRET). Recomendado definir uno propio.
FILE_URL_SIGNING_SECRET=""

# Almacenamiento (ver README.md, sección "Almacenamiento S3").
# Proveedor para escrituras nuevas: LOCAL (disco, en backend/uploads) o S3.
STORAGE_WRITE_PROVIDER="LOCAL"
# Solo con S3 (SeaweedFS / MinIO / AWS S3 u otro compatible). El navegador
# sube y descarga directo contra S3_ENDPOINT con URLs firmadas: tiene que ser
# alcanzable con la misma URL desde el backend y desde el navegador.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="link-files"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# true para SeaweedFS y MinIO (path-style addressing: /bucket/key)
S3_FORCE_PATH_STYLE="true"

# Logging (ver docs/design/LOGGING_PLAN.md). Ambas opcionales.
# Nivel mínimo emitido: fatal|error|warn|info|debug|trace|silent. Default "info".
LOG_LEVEL="info"
# "true" activa pino-pretty (salida coloreada, legible en una terminal humana).
# Recomendado "true" en desarrollo, "false" (default) en producción — ahí el
# log tiene que ser JSON por línea para que jq/cualquier agregador lo consuma.
LOG_PRETTY="false"
