# Cadena de conexión a PostgreSQL usada por Prisma (ver prisma.config.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/chat_interno?schema=public"

# URL base del microservicio EXTERNAL_AUTH (sin el sufijo /v1/login)
EXTERNAL_AUTH_API_URL="https://external-auth.example.com"
# Código de esta aplicación registrado en EXTERNAL_AUTH
APP_CODE_EXTERNAL_AUTH="chat-interno"
# Secreto compartido para verificar los JWT emitidos por EXTERNAL_AUTH (HS256)
EXTERNAL_AUTH_JWT_SECRET="change-me"

# Tamaño máximo (en MB) de un archivo adjunto. Opcional, default 2048.
# Solo usado como semilla de AppSettings.maxUploadSizeMb en el primer
# arranque — el camino directo de subida sigue tope-ado por
# ABSOLUTE_MAX_UPLOAD_BYTES (32 MB, ver file.route.ts) hasta que exista el
# upload chunked (ver LARGE_FILES_PLAN.md).
MAX_UPLOAD_SIZE_MB=2048

# Web Push (notificaciones con la app/pestaña cerrada). Generar un par nuevo con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"
# mailto: o https: de contacto, requerido por la spec de Web Push.
VAPID_SUBJECT="mailto:change-me@example.com"

# Origen(es) permitidos para la API HTTP y el socket (separados por coma si
# son varios). Sin definir, se acepta cualquier origen — cómodo en dev/LAN,
# pero en producción hay que restringirlo al dominio real del frontend.
CORS_ORIGIN="https://link.example.org"

# GIFs y stickers (buscador de Giphy, ver modules/giphy/README.md). Sacar una
# key gratis en https://developers.giphy.com/dashboard/ (app tipo "API").
# Opcional: sin definir, /v1/giphy/* responde 503 en vez de romper el arranque.
GIPHY_API_KEY="change-me"

# Secreto para firmar tokens HMAC en URLs de descarga de archivos (Fase 2 de LARGE_FILES_PLAN.md).
# Opcional: sin definir, se usa EXTERNAL_AUTH_JWT_SECRET como fallback.
FILE_URL_SIGNING_SECRET="change-me"

# Almacenamiento S3 (SeaweedFS / MinIO / AWS S3) — LARGE_FILES_PLAN.md Fase 3
# Proveedor por defecto para escrituras nuevas: LOCAL o S3 (default LOCAL si no se define)
STORAGE_WRITE_PROVIDER="LOCAL"
# Endpoint del gateway S3 (ej. http://127.0.0.1:8333 para SeaweedFS en localhost)
S3_ENDPOINT="http://127.0.0.1:8333"
S3_REGION="us-east-1"
S3_BUCKET="link-files"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
# Obligatorio en true para SeaweedFS (path-style addressing: /bucket/key)
S3_FORCE_PATH_STYLE="true"

# Logging (ver LOGGING_PLAN.md). Ambas opcionales.
# Nivel mínimo emitido: fatal|error|warn|info|debug|trace|silent. Default "info".
LOG_LEVEL="info"
# "true" activa pino-pretty (salida coloreada, legible en una terminal humana).
# Recomendado "true" en desarrollo, "false" (default) en producción — ahí el
# log tiene que ser JSON por línea para que jq/cualquier agregador lo consuma.
LOG_PRETTY="false"

