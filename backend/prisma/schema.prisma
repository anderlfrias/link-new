// Prisma schema — Modelo de datos del chat.
// Únicamente modelos, enums y relaciones. Sin lógica de negocio.
// La URL de conexión se resuelve en `prisma.config.ts`, no en este archivo (Prisma 7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

/// Proveedor de autenticación de la instalación.
/// Se define una única vez al instalar la aplicación y no cambia después.
/// Reservado para uso futuro: todavía no se lee desde variables de entorno
/// ni se usa en ningún modelo o lógica de configuración.
enum AuthProvider {
  /// La propia aplicación administra sus usuarios.
  LOCAL    @map("local")
  /// Un sistema externo (ERP, SSO, etc.) administra y autentica a los usuarios.
  EXTERNAL @map("external")

  @@map("auth_provider")
}

/// Estado del perfil de usuario dentro del chat.
enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("user_status")
}

/// Tipo de conversación.
enum ConversationType {
  /// Conversación entre dos usuarios.
  PRIVATE @map("private")
  /// Conversación con más de dos participantes.
  GROUP   @map("group")

  @@map("conversation_type")
}

/// Tipo de mensaje.
enum MessageType {
  /// Mensaje escrito por un usuario.
  TEXT   @map("text")
  /// Mensaje generado por el sistema (ej. "Juan agregó a Pedro").
  SYSTEM @map("system")

  @@map("message_type")
}

/// Acciones auditables dentro del chat.
enum ChatAuditAction {
  CREATE_CONVERSATION @map("create_conversation")
  ADD_MEMBER          @map("add_member")
  REMOVE_MEMBER       @map("remove_member")
  SEND_MESSAGE        @map("send_message")
  EDIT_MESSAGE        @map("edit_message")
  DELETE_MESSAGE      @map("delete_message")
  CHANGE_NAME         @map("change_name")
  CHANGE_IMAGE        @map("change_image")
  SET_GROUP_ADMIN     @map("set_group_admin")

  @@map("chat_audit_action")
}

/// Proveedor de almacenamiento físico donde vive un `StoredFile`.
/// Preparado para incorporar más adelante MINIO, S3, R2, etc. sin cambiar
/// el modelo `StoredFile`: solo se agregarían nuevos valores a este enum.
enum FileProvider {
  /// Disco local del servidor (ver `src/storage`).
  LOCAL @map("local")

  @@map("file_provider")
}

/// Nivel de permiso para una acción sobre grupos, usado por `AppSettings` y,
/// cuando el override correspondiente está habilitado, por
/// `ConversationGroupSettings` (ver settings.service.ts,
/// resolveEffectiveGroupSettings). No todos los valores aplican a todos los
/// campos que lo usan (ver `settings.validator.ts`): `whoCanCreateGroups`
/// solo admite ALL_MEMBERS/APP_ADMINS_ONLY (no existe grupo ni admin de
/// grupo antes de que el grupo exista); el resto de los campos admiten los
/// cuatro valores. GROUP_ADMINS_ONLY y APP_ADMINS_ONLY son conceptos
/// distintos: el primero depende de `ConversationMember.isAdmin` (admin de
/// ESE grupo), el segundo del rol "admin" de la app (viene de EXTERNAL_AUTH).
enum GroupPermissionLevel {
  ALL_MEMBERS       @map("all_members")
  GROUP_ADMINS_ONLY @map("group_admins_only")
  APP_ADMINS_ONLY   @map("app_admins_only")
  CREATOR_ONLY      @map("creator_only")

  @@map("group_permission_level")
}

/// Modo de restricción de tipo de archivo para adjuntos de mensajes.
/// DISABLED preserva el comportamiento actual (sin allowlist, ver
/// `file.service.ts`).
enum FileTypeRestrictionMode {
  DISABLED  @map("disabled")
  ALLOWLIST @map("allowlist")
  BLOCKLIST @map("blocklist")

  @@map("file_type_restriction_mode")
}

// ─────────────────────────────────────────────
// Modelos
// ─────────────────────────────────────────────

/// Perfil de usuario dentro del chat.
///
/// Existe siempre, sin importar el `AuthProvider` configurado: la autenticación
/// puede resolverla la propia aplicación (LOCAL) o un sistema externo (EXTERNAL),
/// pero el chat mantiene su propio registro para guardar información que no
/// pertenece al sistema de autenticación (perfil, estado, avatar, etc.).
///
/// Todas las relaciones del chat usan siempre `id` (interno). `externalId`
/// nunca se usa como llave foránea.
model User {
  id String @id @default(uuid())

  /// Identificador del usuario en el sistema externo de autenticación.
  /// Null cuando `AuthProvider` es LOCAL. Con `AuthProvider` EXTERNAL, almacena
  /// el id con el que ese sistema identifica al usuario.
  externalId String? @unique @map("external_id")

  /// Sistema externo que sincronizó este perfil por última vez (ej. "external-auth").
  /// Null cuando el usuario nunca se sincronizó desde un proveedor externo.
  /// Ver `constants/identity-provider.constant.ts`.
  identityProvider String? @map("identity_provider")

  /// Nombre de usuario en el sistema externo de autenticación. Null cuando
  /// el usuario no proviene de un proveedor externo que lo defina.
  username String? @unique

  name  String
  /// Debe ser único sin importar el proveedor de autenticación.
  email String @unique

  /// Archivo (`StoredFile`) usado como avatar. Nunca se guarda una ruta directamente aquí.
  avatarFileId String?     @map("avatar_file_id")
  avatarFile   StoredFile? @relation("UserAvatarFile", fields: [avatarFileId], references: [id])

  /// Si es true (default), el login — y la sincronización de contactos vía
  /// `/apps/users/by-codes` (ver `auth.service.ts`, `syncAppUsers`) — sigue
  /// actualizando `name`/avatar desde el proveedor de identidad externo
  /// configurado (hoy EXTERNAL_AUTH, pero el mecanismo es genérico: podría ser
  /// cualquier otro). Pasa a false la primera vez que este usuario cambia su
  /// nombre o su foto acá (`auth.service.ts`, `setLocalName`/`setLocalAvatar`)
  /// — desde ese momento esos dos campos viven únicamente en esta base y
  /// nunca más se sobreescriben desde afuera.
  syncProfileWithIntegration Boolean @default(true) @map("sync_profile_with_integration")

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdConversations    Conversation[]
  conversationMemberships ConversationMember[]
  sentMessages            Message[]            @relation("MessageSender")
  deletedMessages         Message[]            @relation("MessageDeletedBy")
  auditLogs               ChatAuditLog[]
  /// Archivos que este usuario subió (`StoredFile.createdBy`).
  uploadedFiles           StoredFile[]         @relation("StoredFileCreatedBy")

  @@map("users")
}

/// Representa una conversación privada o grupal.
model Conversation {
  id   String           @id @default(uuid())
  /// Nombre de la conversación. Solo aplica a conversaciones grupales.
  name String?
  type ConversationType

  /// Archivo (`StoredFile`) usado como imagen. Solo aplica a conversaciones grupales.
  /// Nunca se guarda una ruta directamente aquí.
  imageFileId String?     @map("image_file_id")
  imageFile   StoredFile? @relation("ConversationImageFile", fields: [imageFileId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  /// Puntero denormalizado al último mensaje, para listar conversaciones sin agregaciones costosas.
  /// No es una relación de Prisma para evitar una dependencia circular obligatoria con Message.
  lastMessageId       String?   @map("last_message_id")
  /// Fecha del último mensaje, usada para ordenar la lista de conversaciones.
  lastMessageAt       DateTime? @map("last_message_at")
  /// Quién envió `lastMessageId`. Sin esto, mostrar "✓✓ Leído" junto al último
  /// mensaje en la lista de conversaciones (solo tiene sentido si el mensaje es
  /// mío) obligaría a leer `Message` por cada conversación de la lista.
  lastMessageSenderId String?   @map("last_message_sender_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Borrado lógico de la conversación.
  deletedAt DateTime? @map("deleted_at")

  members       ConversationMember[]
  messages      Message[]
  auditLogs     ChatAuditLog[]
  /// Overrides por-grupo de las dimensiones marcadas como overrideables en
  /// `AppSettings`. Ver `ConversationGroupSettings` — no existe fila hasta el
  /// primer PATCH de settings de este grupo.
  groupSettings ConversationGroupSettings?

  @@index([createdById])
  @@map("conversations")
}

/// Relación entre un usuario y una conversación a la que pertenece.
model ConversationMember {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now()) @map("joined_at")

  /// Puntero denormalizado al último mensaje leído por este miembro, para calcular no leídos sin recorrer todos los mensajes.
  /// No es una relación de Prisma por la misma razón que `Conversation.lastMessageId`.
  lastReadMessageId String?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")

  /// Mismo patrón que `lastReadMessageId`/`lastReadAt`, pero para "entregado":
  /// que al miembro le llegó el mensaje (push en vivo por socket, o al pedir el
  /// historial), sin que haya hecho nada explícito todavía. "Leído" siempre
  /// implica "entregado", pero no al revés — ver conversation.service.ts
  /// (`computeReceipts`) para cómo se combinan en un solo estado por mensaje.
  lastDeliveredMessageId String?   @map("last_delivered_message_id")
  lastDeliveredAt        DateTime? @map("last_delivered_at")

  /// True si este miembro es admin de ESTE grupo (concepto separado del rol
  /// app-wide "admin" de EXTERNAL_AUTH — ver `GroupPermissionLevel`). El creador de
  /// la conversación siempre lo tiene en true al crearse (ver
  /// conversation.repository.ts, createConversation) y nunca puede
  /// degradarse (invariante forzado en conversation.service.ts,
  /// setMemberAdminStatus). Sin significado para PRIVATE (siempre false,
  /// nunca se lee/escribe ahí).
  isAdmin Boolean @default(false) @map("is_admin")

  /// Preferencias personales de organización de este miembro sobre ESTA
  /// conversación — nunca globales, cada miembro tiene las suyas propias (ver
  /// conversation.service.ts, setConversationPinned/setConversationFavorite).
  /// Un chat fijado por mí no aparece fijado para el resto de los miembros.
  isPinned   Boolean @default(false) @map("is_pinned")
  isFavorite Boolean @default(false) @map("is_favorite")

  /// Un usuario solo puede tener una membresía por conversación.
  @@unique([conversationId, userId])
  @@map("conversation_members")
}

/// Representa un mensaje enviado dentro de una conversación.
model Message {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String @map("sender_id")
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  type    MessageType
  /// Contenido del mensaje. Para mensajes SYSTEM, es el texto descriptivo del evento.
  content String

  /// Fecha de la última edición del mensaje, si fue editado.
  editedAt    DateTime? @map("edited_at")
  /// Borrado lógico del mensaje.
  deletedAt   DateTime? @map("deleted_at")
  /// Usuario que eliminó el mensaje, si el borrado no lo hizo el propio autor.
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("MessageDeletedBy", fields: [deletedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  /// Archivos adjuntos, a través de la tabla intermedia `MessageFile`.
  files     MessageFile[]
  auditLogs ChatAuditLog[]

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

/// Representa un archivo físico almacenado por el sistema, sin importar quién lo use
/// ni para qué (avatar de usuario, imagen de conversación, adjunto de mensaje, etc.).
/// Toda la información técnica y física del archivo vive únicamente aquí; el resto
/// de los modelos solo lo referencian por relación, nunca duplican sus datos.
model StoredFile {
  id String @id @default(uuid())

  originalName String @map("original_name")
  /// Nombre físico con el que se guarda el archivo (evita colisiones y no expone el nombre original).
  storedName   String @map("stored_name")
  /// Ruta relativa dentro del proveedor de almacenamiento (ej. "chat/550e8400.pdf").
  /// Nunca una URL completa ni una ruta absoluta: el proveedor genera la URL pública cuando haga falta.
  path         String
  mimeType     String @map("mime_type")
  extension    String
  /// Tamaño del archivo en bytes.
  size         Int

  /// Proveedor de almacenamiento donde vive físicamente el archivo.
  provider FileProvider
  /// Hash del contenido del archivo, para verificar integridad o detectar duplicados.
  checksum String?

  /// Usuario que subió el archivo. Nullable porque algunos archivos podrán
  /// generarse sin un usuario asociado (ej. procesos del sistema).
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("StoredFileCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  /// Borrado lógico del archivo.
  deletedAt DateTime? @map("deleted_at")

  avatarOfUsers        User[]         @relation("UserAvatarFile")
  imageOfConversations Conversation[] @relation("ConversationImageFile")
  messageFiles         MessageFile[]

  @@index([createdById])
  @@map("stored_files")
}

/// Relación entre un mensaje y un archivo que usa (`StoredFile`).
/// No contiene información propia del archivo: eso vive siempre en `StoredFile`.
model MessageFile {
  id String @id @default(uuid())

  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id])

  fileId String     @map("file_id")
  file   StoredFile @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([fileId])
  @@map("message_files")
}

/// Historial de acciones importantes del chat, únicamente para auditoría.
model ChatAuditLog {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  messageId String?  @map("message_id")
  message   Message? @relation(fields: [messageId], references: [id])

  action   ChatAuditAction
  /// Datos adicionales de la acción (ej. nombre anterior/nuevo en CHANGE_NAME).
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@map("chat_audit_logs")
}

/// Configuración global de la instalación, editable en runtime por un usuario
/// con rol "admin" (ver `settings` module). Fila única (singleton): siempre
/// id fijo "singleton", garantizado por upsert-on-read en
/// `settings.repository.ts` — no requiere script de seed aparte.
model AppSettings {
  id String @id @default("singleton")

  // Adjuntos
  maxUploadSizeMb         Int                     @default(25) @map("max_upload_size_mb")
  fileTypeRestrictionMode FileTypeRestrictionMode @default(DISABLED) @map("file_type_restriction_mode")
  /// Mime types interpretados según `fileTypeRestrictionMode` (allowlist o blocklist).
  fileTypeList            String[]                @default([]) @map("file_type_list")

  // Notas de voz
  maxVoiceNoteDurationSeconds Int @default(300) @map("max_voice_note_duration_seconds")

  // Grupos
  maxGroupMembers       Int                  @default(256) @map("max_group_members")
  whoCanCreateGroups    GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_create_groups")
  whoCanAddMembers      GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_add_members")
  /// Default CREATOR_ONLY: coincide con la regla hardcodeada histórica en
  /// conversation.service.ts (removeMember), así el primer deploy no cambia
  /// comportamiento hasta que un admin lo edite.
  whoCanRemoveMembers   GroupPermissionLevel @default(CREATOR_ONLY) @map("who_can_remove_members")
  /// Default ALL_MEMBERS: reproduce el comportamiento histórico (sin gate)
  /// de `updateConversation` antes de que este campo existiera.
  whoCanChangeGroupInfo GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_change_group_info")
  /// Default CREATOR_ONLY: reproduce el comportamiento hardcodeado histórico
  /// de `deleteConversation` antes de que este campo existiera.
  whoCanDeleteGroup     GroupPermissionLevel @default(CREATOR_ONLY) @map("who_can_delete_group")

  // Permiten que los admins de un grupo específico sobrescriban, solo para SU
  // grupo, el valor global de la dimensión correspondiente (ver
  // ConversationGroupSettings, settings.service.ts#resolveEffectiveGroupSettings).
  // Default false en las 5: hasta que un admin de la app lo habilite
  // explícitamente, el valor global rige siempre para todos los grupos — cero
  // cambio de comportamiento en el primer deploy de esta feature.
  allowGroupOverrideAddMembers      Boolean @default(false) @map("allow_group_override_add_members")
  allowGroupOverrideRemoveMembers   Boolean @default(false) @map("allow_group_override_remove_members")
  allowGroupOverrideMaxGroupMembers Boolean @default(false) @map("allow_group_override_max_group_members")
  allowGroupOverrideChangeGroupInfo Boolean @default(false) @map("allow_group_override_change_group_info")
  allowGroupOverrideDeleteGroup     Boolean @default(false) @map("allow_group_override_delete_group")

  // Retención de mensajes
  /// null = deshabilitado (default). Nunca empieza a borrar datos de una
  /// instalación existente sin que un admin lo prenda explícitamente.
  messageRetentionDays Int? @map("message_retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Overrides por-grupo de las dimensiones marcadas como overrideables en
/// `AppSettings` (ver los `allowGroupOverride*` ahí). Fila 1:1 opcional con
/// `Conversation` — no existe fila hasta el primer PATCH de group-settings de
/// ese grupo (ver conversation.service.ts, updateGroupSettings). Cada
/// columna null = "este grupo no fijó su propio valor, hereda el global" —
/// ver settings.service.ts, resolveEffectiveGroupSettings, para cómo se
/// combina con `AppSettings` y los `allowGroupOverride*`. Sin significado
/// para PRIVATE (nunca se crea una fila para una PRIVATE).
model ConversationGroupSettings {
  conversationId String       @id @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  whoCanAddMembers      GroupPermissionLevel? @map("who_can_add_members")
  whoCanRemoveMembers   GroupPermissionLevel? @map("who_can_remove_members")
  maxGroupMembers       Int?                  @map("max_group_members")
  whoCanChangeGroupInfo GroupPermissionLevel? @map("who_can_change_group_info")
  whoCanDeleteGroup     GroupPermissionLevel? @map("who_can_delete_group")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("conversation_group_settings")
}
