// Prisma schema — Modelo de datos del chat.
// Únicamente modelos, enums y relaciones. Sin lógica de negocio.
// La URL de conexión se resuelve en `prisma.config.ts`, no en este archivo (Prisma 7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

/// Estado del perfil de usuario dentro del chat.
enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("user_status")
}

/// Tipo de conversación.
enum ConversationType {
  /// Conversación entre dos usuarios.
  PRIVATE @map("private")
  /// Conversación con más de dos participantes.
  GROUP   @map("group")
  /// Conversación de un usuario consigo mismo ("Mensajes guardados", tipo
  /// Telegram) — un único miembro (el propio usuario). No reutiliza PRIVATE
  /// porque esa validación exige exactamente OTRO miembro (ver
  /// conversation.service.ts, createConversation) y `ConversationMember` tiene
  /// `@@unique([conversationId, userId])`, así que dos filas con el mismo
  /// usuario en la misma conversación no son representables.
  SELF    @map("self")

  @@map("conversation_type")
}

/// Tipo de mensaje.
enum MessageType {
  /// Mensaje escrito por un usuario.
  TEXT    @map("text")
  /// Mensaje generado por el sistema (ej. "Juan agregó a Pedro").
  SYSTEM  @map("system")
  /// Sticker elegido desde el buscador de Giphy — siempre `content: ""` y
  /// exactamente un `fileId` (ver message.service.ts#sendMessage). Se
  /// renderiza sin fondo de burbuja (ver MessageBubble.tsx en el frontend),
  /// a diferencia de un GIF (que viaja como TEXT + adjunto normal).
  STICKER @map("sticker")
  /// Contacto compartido — contiene los datos del contacto en formato JSON en `content`
  /// y se renderiza con tarjeta interactiva en el frontend.
  CONTACT @map("contact")
  /// Encuesta dentro de un chat grupal con opciones interactivas y votación en tiempo real.
  POLL    @map("poll")
  /// Registro de llamada o videollamada.
  CALL    @map("call")

  @@map("message_type")
}

/// Acciones registradas en el audit trail (ver src/modules/audit/README.md).
/// El @@map conserva el nombre físico original del tipo en Postgres: renombrar
/// el modelo en Prisma no toca la base.
enum AuditAction {
  CREATE_CONVERSATION @map("create_conversation")
  ADD_MEMBER          @map("add_member")
  REMOVE_MEMBER       @map("remove_member")
  SEND_MESSAGE        @map("send_message")
  FORWARD_MESSAGE     @map("forward_message")
  EDIT_MESSAGE        @map("edit_message")
  DELETE_MESSAGE      @map("delete_message")
  CHANGE_NAME         @map("change_name")
  CHANGE_IMAGE        @map("change_image")
  SET_GROUP_ADMIN     @map("set_group_admin")

  /// Autenticación. No existe LOGOUT a propósito: los JWT (de EXTERNAL_AUTH o los del
  /// modo local) son stateless y el logout ocurre enteramente en el cliente
  /// (descarta el token) — el backend no lo observa. Auditar un evento que no
  /// se puede detectar daría un trail con huecos que parecen datos.
  LOGIN           @map("login")
  LOGIN_FAILED    @map("login_failed")
  /// Gestión de cuentas (LOCAL_AUTH_PLAN.md, D21). Nunca llevan contraseña,
  /// hash ni token en la metadata.
  CREATE_USER     @map("create_user")
  UPDATE_USER     @map("update_user")
  RESET_PASSWORD  @map("reset_password")
  CHANGE_PASSWORD @map("change_password")

  /// Acciones de administración de la instalación.
  UPDATE_SETTINGS   @map("update_settings")
  ADMIN_DELETE_FILE @map("admin_delete_file")

  /// Llamadas y videollamadas
  START_CALL @map("start_call")
  END_CALL   @map("end_call")

  @@map("chat_audit_action")
}

/// Proveedor de almacenamiento físico donde vive un `StoredFile`. Es el
/// marcador que permite convivir archivos en distintos proveedores a la vez
/// durante una migración gradual (ver LARGE_FILES_PLAN.md).
enum FileProvider {
  /// Disco local del servidor (ver `src/storage`).
  LOCAL @map("local")
  /// Cualquier storage compatible con la API S3 (SeaweedFS hoy, ver
  /// LARGE_FILES_PLAN.md). Declarado antes de que exista `S3Storage` en
  /// `src/storage` — hasta esa fase, ningún `StoredFile` se crea con este
  /// valor todavía.
  S3    @map("s3")

  @@map("file_provider")
}

/// Tipo de llamada (audio o video).
enum CallType {
  AUDIO @map("audio")
  VIDEO @map("video")

  @@map("call_type")
}

/// Estado de una llamada.
enum CallStatus {
  RINGING   @map("ringing")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  MISSED    @map("missed")
  COMPLETED @map("completed")
  BUSY      @map("busy")

  @@map("call_status")
}

/// Nivel de permiso para una acción sobre grupos, usado por `AppSettings` y,
/// cuando el override correspondiente está habilitado, por
/// `ConversationGroupSettings` (ver settings.service.ts,
/// resolveEffectiveGroupSettings). No todos los valores aplican a todos los
/// campos que lo usan (ver `settings.validator.ts`): `whoCanCreateGroups`
/// solo admite ALL_MEMBERS/APP_ADMINS_ONLY (no existe grupo ni admin de
/// grupo antes de que el grupo exista); el resto de los campos admiten los
/// cuatro valores. GROUP_ADMINS_ONLY y APP_ADMINS_ONLY son conceptos
/// distintos: el primero depende de `ConversationMember.isAdmin` (admin de
/// ESE grupo), el segundo del rol "admin" de la app (`User.roles`).
enum GroupPermissionLevel {
  ALL_MEMBERS       @map("all_members")
  GROUP_ADMINS_ONLY @map("group_admins_only")
  APP_ADMINS_ONLY   @map("app_admins_only")
  CREATOR_ONLY      @map("creator_only")

  @@map("group_permission_level")
}

/// Modo de restricción de tipo de archivo para adjuntos de mensajes.
/// DISABLED preserva el comportamiento actual (sin allowlist, ver
/// `file.service.ts`).
enum FileTypeRestrictionMode {
  DISABLED  @map("disabled")
  ALLOWLIST @map("allowlist")
  BLOCKLIST @map("blocklist")

  @@map("file_type_restriction_mode")
}

// ─────────────────────────────────────────────
// Modelos
// ─────────────────────────────────────────────

/// Perfil de usuario dentro del chat.
///
/// Existe siempre, sin importar el `AuthProvider` configurado: la autenticación
/// puede resolverla la propia aplicación (LOCAL) o un sistema externo (EXTERNAL),
/// pero el chat mantiene su propio registro para guardar información que no
/// pertenece al sistema de autenticación (perfil, estado, avatar, etc.).
///
/// Todas las relaciones del chat usan siempre `id` (interno). `externalId`
/// nunca se usa como llave foránea.
model User {
  id String @id @default(uuid())

  /// Identificador del usuario en el sistema externo de autenticación (hoy
  /// EXTERNAL_AUTH). Null para las cuentas creadas en modo local. Ninguna relación lo
  /// usa: todas van por `id` (ver backend/README.md).
  externalId String? @unique @map("external_id")

  /// Sistema externo que sincronizó este perfil por última vez (ej. "external-auth").
  /// Null cuando el usuario nunca se sincronizó desde un proveedor externo.
  /// Ver `constants/identity-provider.constant.ts`.
  identityProvider String? @map("identity_provider")

  /// Nombre de usuario. En modo external-auth lo define EXTERNAL_AUTH; en modo local es
  /// opcional (LOCAL_AUTH_PLAN.md, D11): `a-z 0-9 . _`, sin "@", guardado en
  /// minúsculas. Las cuentas que vienen de EXTERNAL_AUTH conservan el suyo.
  username String? @unique

  name  String
  /// Debe ser único sin importar el proveedor de autenticación.
  email String @unique

  /// Archivo (`StoredFile`) usado como avatar. Nunca se guarda una ruta directamente aquí.
  avatarFileId String?     @map("avatar_file_id")
  avatarFile   StoredFile? @relation("UserAvatarFile", fields: [avatarFileId], references: [id])

  /// Si es true (default), el login — y la sincronización de contactos vía
  /// `/apps/users/by-codes` (ver `auth.service.ts`, `syncAppUsers`) — sigue
  /// actualizando `name`/avatar desde el proveedor de identidad externo
  /// configurado (hoy EXTERNAL_AUTH, pero el mecanismo es genérico: podría ser
  /// cualquier otro). Pasa a false la primera vez que este usuario cambia su
  /// nombre o su foto acá (`auth.service.ts`, `setLocalName`/`setLocalAvatar`)
  /// — desde ese momento esos dos campos viven únicamente en esta base y
  /// nunca más se sobreescriben desde afuera.
  syncProfileWithIntegration Boolean @default(true) @map("sync_profile_with_integration")

  status UserStatus @default(ACTIVE)

  /// Preferencia 100% local del usuario — nunca sincronizada desde el
  /// proveedor externo de identidad (a diferencia de `name`/avatar, no tiene
  /// equivalente en EXTERNAL_AUTH). Controla si `message:created` dispara un sonido
  /// en su cliente (ver frontend/src/features/conversations/hooks/use-new-message-sound.ts).
  notificationSoundEnabled Boolean @default(true) @map("notification_sound_enabled")

  /// Idioma preferido del usuario ("es" | "en") — preferencia 100% local.
  language String @default("es") @map("language")

  /// Roles de la cuenta (solo los que la app conoce, hoy "admin"). En modo local
  /// los asigna un admin (LOCAL_AUTH_PLAN.md, D8); con un proveedor externo se
  /// sobrescriben en cada login con los que entregue el proveedor. La columna
  /// conserva su nombre original (`local_roles`): no hay migración.
  roles            String[]         @default([]) @map("local_roles")
  /// Modo local: los tokens con `iat` anterior se rechazan (D9). Se guarda
  /// truncado al segundo, porque `iat` está en segundos.
  tokensValidAfter DateTime?        @map("tokens_valid_after")
  /// Credenciales del modo local, en tabla aparte a propósito (D3).
  localCredential  LocalCredential?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdConversations    Conversation[]
  conversationMemberships ConversationMember[]
  sentMessages            Message[]            @relation("MessageSender")
  deletedMessages         Message[]            @relation("MessageDeletedBy")
  auditLogs               AuditLog[]
  /// Archivos que este usuario subió (`StoredFile.createdBy`).
  uploadedFiles           StoredFile[]         @relation("StoredFileCreatedBy")
  fileUploads             FileUpload[]         @relation("FileUploadCreatedBy")
  pushSubscriptions       PushSubscription[]
  reactions               MessageReaction[]
  pollVotes               PollVote[]
  callsInitiated          Call[]               @relation("CallCaller")
  callsReceived           Call[]               @relation("CallReceiver")

  @@map("users")
}

/// Credenciales del modo local (LOCAL_AUTH_PLAN.md, D3). Tabla aparte de
/// `User` a propósito: `attachInternalUser`, el socket y otros cargan la fila
/// entera de `User`, y con el hash ahí alcanzaría con que algún endpoint la
/// serializara para filtrarlo. Un `User` sin fila acá existe, pero en modo
/// local no puede entrar hasta que un admin le asigne una contraseña (por
/// ejemplo, las cuentas que vienen de EXTERNAL_AUTH).
model LocalCredential {
  userId                 String    @id @map("user_id")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `scrypt$N$r$p$salt$hash` (ver modules/auth/password.ts). Nunca se loguea.
  passwordHash           String    @map("password_hash")
  /// Para `AppSettings.passwordHistoryCount`; se poda a N en cada cambio.
  previousPasswordHashes String[]  @default([]) @map("previous_password_hashes")
  mustChangePassword     Boolean   @default(true) @map("must_change_password")
  passwordChangedAt      DateTime  @default(now()) @map("password_changed_at")
  /// Fallos de login seguidos (D17). Se incrementa de forma atómica.
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("local_credentials")
}

/// Representa una conversación privada o grupal.
model Conversation {
  id   String           @id @default(uuid())
  /// Nombre de la conversación. Solo aplica a conversaciones grupales.
  name String?
  type ConversationType

  /// Archivo (`StoredFile`) usado como imagen. Solo aplica a conversaciones grupales.
  /// Nunca se guarda una ruta directamente aquí.
  imageFileId String?     @map("image_file_id")
  imageFile   StoredFile? @relation("ConversationImageFile", fields: [imageFileId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  /// Puntero denormalizado al último mensaje, para listar conversaciones sin agregaciones costosas.
  /// No es una relación de Prisma para evitar una dependencia circular obligatoria con Message.
  lastMessageId       String?   @map("last_message_id")
  /// Fecha del último mensaje, usada para ordenar la lista de conversaciones.
  lastMessageAt       DateTime? @map("last_message_at")
  /// Quién envió `lastMessageId`. Sin esto, mostrar "✓✓ Leído" junto al último
  /// mensaje en la lista de conversaciones (solo tiene sentido si el mensaje es
  /// mío) obligaría a leer `Message` por cada conversación de la lista.
  lastMessageSenderId String?   @map("last_message_sender_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Borrado lógico de la conversación.
  deletedAt DateTime? @map("deleted_at")

  members       ConversationMember[]
  messages      Message[]
  auditLogs     AuditLog[]
  /// Overrides por-grupo de las dimensiones marcadas como overrideables en
  /// `AppSettings`. Ver `ConversationGroupSettings` — no existe fila hasta el
  /// primer PATCH de settings de este grupo.
  groupSettings ConversationGroupSettings?
  fileUploads   FileUpload[]
  calls         Call[]

  @@index([createdById])
  @@map("conversations")
}

/// Relación entre un usuario y una conversación a la que pertenece.
model ConversationMember {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now()) @map("joined_at")

  /// Puntero denormalizado al último mensaje leído por este miembro, para calcular no leídos sin recorrer todos los mensajes.
  /// No es una relación de Prisma por la misma razón que `Conversation.lastMessageId`.
  lastReadMessageId String?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")

  /// Mismo patrón que `lastReadMessageId`/`lastReadAt`, pero para "entregado":
  /// que al miembro le llegó el mensaje (push en vivo por socket, o al pedir el
  /// historial), sin que haya hecho nada explícito todavía. "Leído" siempre
  /// implica "entregado", pero no al revés — ver conversation.service.ts
  /// (`computeReceipts`) para cómo se combinan en un solo estado por mensaje.
  lastDeliveredMessageId String?   @map("last_delivered_message_id")
  lastDeliveredAt        DateTime? @map("last_delivered_at")

  /// True si este miembro es admin de ESTE grupo (concepto separado del rol
  /// app-wide "admin" de EXTERNAL_AUTH — ver `GroupPermissionLevel`). El creador de
  /// la conversación siempre lo tiene en true al crearse (ver
  /// conversation.repository.ts, createConversation) y nunca puede
  /// degradarse (invariante forzado en conversation.service.ts,
  /// setMemberAdminStatus). Sin significado para PRIVATE (siempre false,
  /// nunca se lee/escribe ahí).
  isAdmin Boolean @default(false) @map("is_admin")

  /// Preferencias personales de organización de este miembro sobre ESTA
  /// conversación — nunca globales, cada miembro tiene las suyas propias (ver
  /// conversation.service.ts, setConversationPinned/setConversationFavorite).
  /// Un chat fijado por mí no aparece fijado para el resto de los miembros.
  isPinned   Boolean @default(false) @map("is_pinned")
  isFavorite Boolean @default(false) @map("is_favorite")

  /// Oculta esta conversación SOLO para este miembro ("borrado para mí"), a
  /// diferencia de `Conversation.deletedAt` que la oculta para TODOS. Solo
  /// tiene sentido en PRIVATE — GROUP sigue usando el borrado global vía
  /// `whoCanDeleteGroup`/`allowGroupDelete`. Se limpia sola (vuelve a `null`)
  /// si llega un mensaje nuevo (ver notifyConversationListChanged en
  /// message.service.ts) o si este mismo miembro reinicia el chat con ese
  /// contacto (ver createConversation) — así el chat "reaparece" sin
  /// duplicar nunca la fila de Conversation/ConversationMember.
  hiddenAt DateTime? @map("hidden_at")

  /// Un usuario solo puede tener una membresía por conversación.
  @@unique([conversationId, userId])
  @@map("conversation_members")
}

/// Representa un mensaje enviado dentro de una conversación.
model Message {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String @map("sender_id")
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  /// Mensaje al que este responde (tipo WhatsApp/Telegram) — mismo `conversationId`
  /// siempre, se valida en message.service.ts. Nunca se toca al editar/borrar el
  /// original: si el original se borra (borrado lógico), el puntero sigue firme y
  /// el cliente arma la cita mostrando "Mensaje eliminado" (ver `replyTo` en
  /// message.service.ts, mismo criterio que `buildLastMessagePreview`).
  replyToId String?   @map("reply_to_id")
  replyTo   Message?  @relation("MessageReplyTo", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplyTo")

  /// Mensaje original si este es un reenvío (tipo WhatsApp/Telegram) — a
  /// diferencia de `replyToId`, SÍ puede apuntar a un mensaje de OTRA
  /// conversación (reenviar cruza conversaciones por naturaleza). El mensaje
  /// reenviado es una copia independiente (`content`/adjuntos propios, ver
  /// `forwardMessage` en message.service.ts) — el puntero es solo para poder
  /// mostrar "Reenviado de <remitente original> · <conversación de origen>"
  /// resuelto en vivo (mismo criterio que `replyTo`: si el original se borra
  /// o se renombra el grupo de origen después, el reenvío ya hecho lo refleja
  /// solo la próxima vez que se lea, nunca se "congela" en el momento del reenvío).
  forwardedFromId String?   @map("forwarded_from_id")
  forwardedFrom   Message?  @relation("MessageForward", fields: [forwardedFromId], references: [id])
  forwardedTo     Message[] @relation("MessageForward")

  type    MessageType
  /// Contenido del mensaje. Para mensajes SYSTEM, es el texto descriptivo del evento.
  content String

  /// Fecha de la última edición del mensaje, si fue editado.
  editedAt    DateTime? @map("edited_at")
  /// Borrado lógico del mensaje.
  deletedAt   DateTime? @map("deleted_at")
  /// Usuario que eliminó el mensaje, si el borrado no lo hizo el propio autor.
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("MessageDeletedBy", fields: [deletedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  /// Archivos adjuntos, a través de la tabla intermedia `MessageFile`.
  files     MessageFile[]
  reactions MessageReaction[]
  poll      Poll?
  auditLogs AuditLog[]

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@index([forwardedFromId])
  @@map("messages")
}

/// Representa un archivo físico almacenado por el sistema, sin importar quién lo use
/// ni para qué (avatar de usuario, imagen de conversación, adjunto de mensaje, etc.).
/// Toda la información técnica y física del archivo vive únicamente aquí; el resto
/// de los modelos solo lo referencian por relación, nunca duplican sus datos.
model StoredFile {
  id String @id @default(uuid())

  originalName String @map("original_name")
  /// Nombre físico con el que se guarda el archivo (evita colisiones y no expone el nombre original).
  storedName   String @map("stored_name")
  /// Ruta relativa dentro del proveedor de almacenamiento (ej. "chat/550e8400.pdf").
  /// Nunca una URL completa ni una ruta absoluta: el proveedor genera la URL pública cuando haga falta.
  path         String
  mimeType     String @map("mime_type")
  extension    String
  /// Tamaño del archivo en bytes. `BigInt` porque `Int` (`int4`, máx.
  /// ~2.147 GB) desborda con un solo archivo de 2 GiB — ver
  /// LARGE_FILES_PLAN.md §5.1. La API pública lo sigue exponiendo como
  /// `number` (`toStoredFileResponse`, `Number.MAX_SAFE_INTEGER` son ~9 PB,
  /// sobra de sobra) — el tipo nativo `bigint` solo importa puertas adentro
  /// del backend, y toda lectura de este campo antes de serializar a JSON o
  /// emitir por socket.io debe convertirlo con `Number(...)` primero.
  size         BigInt

  /// Proveedor de almacenamiento donde vive físicamente el archivo.
  provider FileProvider
  /// Hash del contenido del archivo, para verificar integridad o detectar duplicados.
  checksum String?

  /// Usuario que subió el archivo. Nullable porque algunos archivos podrán
  /// generarse sin un usuario asociado (ej. procesos del sistema).
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("StoredFileCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  /// Borrado lógico del archivo.
  deletedAt DateTime? @map("deleted_at")
  /// Fecha de purga física de bytes en storage.
  purgedAt  DateTime? @map("purged_at")

  avatarOfUsers        User[]         @relation("UserAvatarFile")
  imageOfConversations Conversation[] @relation("ConversationImageFile")
  messageFiles         MessageFile[]
  upload               FileUpload?

  @@index([createdById])
  /// Barrido de huérfanos/soft-deleted (ver LARGE_FILES_PLAN.md §5.5).
  @@index([deletedAt])
  @@index([purgedAt])
  /// `listFilesForAdmin` ordena por esta columna (ver file.repository.ts).
  @@index([createdAt])
  @@map("stored_files")
}

/// Relación entre un mensaje y un archivo que usa (`StoredFile`).
/// No contiene información propia del archivo: eso vive siempre en `StoredFile`.
model MessageFile {
  id String @id @default(uuid())

  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id])

  fileId String     @map("file_id")
  file   StoredFile @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([fileId])
  @@map("message_files")
}

/// Reacción de un usuario a un mensaje con un emoji.
model MessageReaction {
  id String @id @default(uuid())

  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Emoji seleccionado (ej. "👍", "❤️", "😂", "😮", "😢", "🙏").
  emoji String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

/// Encuesta asociada a un mensaje grupal.
model Poll {
  id            String       @id @default(uuid())
  messageId     String       @unique @map("message_id")
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question      String
  allowMultiple Boolean      @default(false) @map("allow_multiple")
  options       PollOption[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("polls")
}

/// Opción de respuesta en una encuesta.
model PollOption {
  id     String     @id @default(uuid())
  pollId String     @map("poll_id")
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int        @default(0)
  votes  PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

/// Voto de un usuario en una opción de encuesta.
model PollVote {
  id        String     @id @default(uuid())
  optionId  String     @map("option_id")
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([optionId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}

model AuditLog {
  id String @id @default(uuid())

  /// Nullable desde que se auditan los intentos de login fallidos: en un
  /// LOGIN_FAILED puede no haber ningún `User` local al que apuntar (usuario
  /// inexistente, o que nunca entró a esta app). `actorEmail` guarda entonces
  /// la identidad que se intentó usar.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  /// Identidad tal como la presentó el actor. Se guarda SIEMPRE, incluso con
  /// `userId` presente: un audit trail tiene que seguir siendo legible aunque
  /// ese `User` cambie de email más adelante.
  actorEmail String? @map("actor_email")

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  messageId String?  @map("message_id")
  message   Message? @relation(fields: [messageId], references: [id])

  /// Recurso afectado cuando no es una conversación ni un mensaje: un
  /// `StoredFile`, la fila singleton de `AppSettings`, etc. Par genérico a
  /// propósito — una FK por cada tipo auditable obligaría a tocar este modelo
  /// con cada feature nueva.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  action   AuditAction
  /// Datos adicionales de la acción. **Esquema cerrado**, documentado y tipado
  /// en `src/modules/audit/audit.types.ts` — NUNCA contenido de mensajes
  /// (LOGGING_PLAN.md §4.1 y §4.6).
  metadata Json?

  /// Contexto de la petición. `ip` es el visitante real y no Cloudflare gracias
  /// a `app.set("trust proxy", 1)` (ver app.ts). `requestId` ata esta fila al
  /// log de aplicación de la misma request.
  ip        String? @map("ip")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  /// Filtro del panel de admin (Fase 4): "todas las acciones X, más recientes primero".
  @@index([action, createdAt])
  /// Orden por defecto del listado y barrido del worker de retención (Fase 5).
  @@index([createdAt])
  @@map("chat_audit_logs")
}

/// Configuración global de la instalación, editable en runtime por un usuario
/// con rol "admin" (ver `settings` module). Fila única (singleton): siempre
/// id fijo "singleton", garantizado por upsert-on-read en
/// `settings.repository.ts` — no requiere script de seed aparte.
model AppSettings {
  id String @id @default("singleton")

  // Adjuntos
  maxUploadSizeMb         Int                     @default(25) @map("max_upload_size_mb")
  fileTypeRestrictionMode FileTypeRestrictionMode @default(DISABLED) @map("file_type_restriction_mode")
  /// Mime types interpretados según `fileTypeRestrictionMode` (allowlist o blocklist).
  fileTypeList            String[]                @default([]) @map("file_type_list")
  /// Máximo de archivos (`fileIds`) que puede llevar un solo mensaje (ver
  /// message.service.ts, sendMessage). null = sin límite. Default 10 (no
  /// null): a diferencia del resto de los límites de este modelo, acá el
  /// comportamiento histórico (sin ningún límite) es el que se considera el
  /// problema a resolver, así que el primer deploy de este campo ya aplica
  /// una restricción razonable en vez de esperar a que un admin la prenda.
  maxFilesPerMessage      Int?                    @default(10) @map("max_files_per_message")

  // Borrado de conversaciones PRIVATE ("para mí" — ver ConversationMember.hiddenAt)
  /// Default true: cualquiera puede borrar su chat privado hasta que un admin
  /// lo desactive explícitamente.
  allowConversationDelete Boolean @default(true) @map("allow_conversation_delete")

  // Notas de voz
  maxVoiceNoteDurationSeconds Int @default(300) @map("max_voice_note_duration_seconds")

  // Grupos
  maxGroupMembers       Int                  @default(256) @map("max_group_members")
  whoCanCreateGroups    GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_create_groups")
  whoCanAddMembers      GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_add_members")
  /// Default CREATOR_ONLY: coincide con la regla hardcodeada histórica en
  /// conversation.service.ts (removeMember), así el primer deploy no cambia
  /// comportamiento hasta que un admin lo edite.
  whoCanRemoveMembers   GroupPermissionLevel @default(CREATOR_ONLY) @map("who_can_remove_members")
  /// Default ALL_MEMBERS: reproduce el comportamiento histórico (sin gate)
  /// de `updateConversation` antes de que este campo existiera.
  whoCanChangeGroupInfo GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_change_group_info")
  /// Default CREATOR_ONLY: reproduce el comportamiento hardcodeado histórico
  /// de `deleteConversation` antes de que este campo existiera.
  whoCanDeleteGroup     GroupPermissionLevel @default(CREATOR_ONLY) @map("who_can_delete_group")
  /// Interruptor maestro: si es false, NADIE puede borrar un GROUP sin
  /// importar `whoCanDeleteGroup` (tampoco un admin de la app) — a diferencia
  /// de las 5 dimensiones de GroupPermissionLevel, esto no es un "quién" sino
  /// un "si". Default true: reproduce el comportamiento histórico.
  allowGroupDelete      Boolean              @default(true) @map("allow_group_delete")
  /// Default ALL_MEMBERS: reproduce el comportamiento histórico donde cualquier
  /// miembro puede salirse del grupo libremente.
  whoCanLeaveGroup      GroupPermissionLevel @default(ALL_MEMBERS) @map("who_can_leave_group")

  // Permiten que los admins de un grupo específico sobrescriban, solo para SU
  // grupo, el valor global de la dimensión correspondiente (ver
  // ConversationGroupSettings, settings.service.ts#resolveEffectiveGroupSettings).
  // Default false en las 5: hasta que un admin de la app lo habilite
  // explícitamente, el valor global rige siempre para todos los grupos — cero
  // cambio de comportamiento en el primer deploy de esta feature.
  allowGroupOverrideAddMembers      Boolean @default(false) @map("allow_group_override_add_members")
  allowGroupOverrideRemoveMembers   Boolean @default(false) @map("allow_group_override_remove_members")
  allowGroupOverrideMaxGroupMembers Boolean @default(false) @map("allow_group_override_max_group_members")
  allowGroupOverrideChangeGroupInfo Boolean @default(false) @map("allow_group_override_change_group_info")
  allowGroupOverrideDeleteGroup     Boolean @default(false) @map("allow_group_override_delete_group")
  allowGroupOverrideLeaveGroup      Boolean @default(false) @map("allow_group_override_leave_group")

  // Retención de mensajes
  /// null = deshabilitado (default). Nunca empieza a borrar datos de una
  /// instalación existente sin que un admin lo prenda explícitamente.
  messageRetentionDays Int? @map("message_retention_days")

  // Retención del audit trail (ver src/modules/audit/README.md).
  /// null = deshabilitado (default): el audit trail se guarda para siempre.
  /// A diferencia del resto de los campos de retención, acá "para siempre" es
  /// además el default correcto por cumplimiento — borrar registros de
  /// auditoría es una decisión que un admin tiene que tomar explícitamente,
  /// nunca algo que pase por omisión al actualizar la app.
  auditLogRetentionDays Int? @map("audit_log_retention_days")

  // Edición y borrado de mensajes propios (ver messages/README.md, editMessage/deleteMessage).
  // Defaults true/null: reproducen el comportamiento histórico (editar/borrar
  // sin restricción) hasta que un admin los ajuste explícitamente.
  /// Si el propio autor puede editar el contenido de un mensaje TEXT ya enviado.
  allowMessageEdit                         Boolean @default(true) @map("allow_message_edit")
  /// Minutos desde el envío durante los que un mensaje puede editarse. null = sin límite.
  messageEditTimeLimitMinutes              Int?    @map("message_edit_time_limit_minutes")
  /// Si el propio autor puede borrar (para todos) un mensaje ya enviado. No
  /// afecta el borrado que hace el creador de la conversación sobre mensajes
  /// ajenos (moderación) — esa vía nunca depende de esta configuración.
  allowMessageDeleteForEveryone            Boolean @default(true) @map("allow_message_delete_for_everyone")
  /// Minutos desde el envío durante los que un mensaje puede borrarse para todos. null = sin límite.
  messageDeleteForEveryoneTimeLimitMinutes Int?    @map("message_delete_for_everyone_time_limit_minutes")

  /// Interruptor maestro del buscador de GIFs/stickers (Giphy, ver
  /// modules/giphy/README.md) — controla tanto si el botón aparece en el
  /// composer como si /v1/giphy/* acepta pedidos (403 si es false, nunca solo
  /// cosmético). Default true: reproduce "disponible" hasta que un admin lo
  /// apague; igual requiere GIPHY_API_KEY configurada para funcionar de verdad.
  allowStickersAndGifs Boolean @default(true) @map("allow_stickers_and_gifs")

  // Limpieza y ciclo de vida de archivos y sesiones (ver LARGE_FILES_PLAN.md §5.5, §11 Fase 5).
  // Defaults false/null: nunca borra datos sin que un admin lo configure explícitamente.
  /// Interruptor maestro del worker de limpieza.
  uploadCleanupEnabled     Boolean @default(false) @map("upload_cleanup_enabled")
  /// Horas tras las que un StoredFile sin referencias (huérfano) se borra físicamente. null = deshabilitado.
  orphanFileRetentionHours Int?    @default(24) @map("orphan_file_retention_hours")
  /// Días tras los que un StoredFile soft-deleted purga sus bytes físicos en storage. null = deshabilitado.
  softDeletedFilePurgeDays Int?    @map("soft_deleted_file_purge_days")
  /// Si es true, el worker solo loguea las acciones en modo simulación sin borrar nada.
  uploadCleanupDryRun      Boolean @default(false) @map("upload_cleanup_dry_run")

  // Migración progresiva de archivos a S3 (ver LARGE_FILES_PLAN.md §7.4, §11 Fase 8).
  // Defaults false/50/60: apagado por defecto para control manual desde el panel admin.
  /// Interruptor maestro del worker de migración progresiva de LOCAL a S3.
  fileMigrationEnabled                Boolean @default(false) @map("file_migration_enabled")
  /// Cantidad de archivos por pasada del worker (más chicos primero).
  fileMigrationBatchSize              Int     @default(50) @map("file_migration_batch_size")
  /// Intervalo en minutos entre cada pasada del worker.
  fileMigrationIntervalMinutes        Int     @default(60) @map("file_migration_interval_minutes")
  /// Si es true, elimina físicamente el archivo local solo tras verificar y commitear en S3.
  fileMigrationDeleteLocalAfterCommit Boolean @default(false) @map("file_migration_delete_local_after_commit")

  // Sesión y contraseñas del modo local (LOCAL_AUTH_PLAN.md §4.4). En modo
  // external-auth no aplican: la sesión y las contraseñas las define EXTERNAL_AUTH. Los
  // defaults no cambian nada hasta que un admin lo decida, salvo el largo
  // mínimo de 12 (acá no hay un comportamiento anterior que preservar).
  /// Duración de la sesión (token) en horas.
  localSessionTtlHours     Int     @default(12) @map("local_session_ttl_hours")
  /// Largo mínimo. El piso de 8 no se puede bajar ni por API (D15).
  passwordMinLength        Int     @default(12) @map("password_min_length")
  passwordRequireUppercase Boolean @default(false) @map("password_require_uppercase")
  passwordRequireLowercase Boolean @default(false) @map("password_require_lowercase")
  passwordRequireNumber    Boolean @default(false) @map("password_require_number")
  passwordRequireSymbol    Boolean @default(false) @map("password_require_symbol")
  /// null = las contraseñas no vencen.
  passwordExpirationDays   Int?    @map("password_expiration_days")
  /// 0 = se puede repetir cualquier contraseña anterior.
  passwordHistoryCount     Int     @default(0) @map("password_history_count")
  /// null = sin bloqueo por cuenta (queda solo el rate limit en memoria).
  maxFailedLoginAttempts   Int?    @map("max_failed_login_attempts")
  lockoutDurationMinutes   Int     @default(15) @map("lockout_duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Overrides por-grupo de las dimensiones marcadas como overrideables en
/// `AppSettings` (ver los `allowGroupOverride*` ahí). Fila 1:1 opcional con
/// `Conversation` — no existe fila hasta el primer PATCH de group-settings de
/// ese grupo (ver conversation.service.ts, updateGroupSettings). Cada
/// columna null = "este grupo no fijó su propio valor, hereda el global" —
/// ver settings.service.ts, resolveEffectiveGroupSettings, para cómo se
/// combina con `AppSettings` y los `allowGroupOverride*`. Sin significado
/// para PRIVATE (nunca se crea una fila para una PRIVATE).
model ConversationGroupSettings {
  conversationId String       @id @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  whoCanAddMembers      GroupPermissionLevel? @map("who_can_add_members")
  whoCanRemoveMembers   GroupPermissionLevel? @map("who_can_remove_members")
  maxGroupMembers       Int?                  @map("max_group_members")
  whoCanChangeGroupInfo GroupPermissionLevel? @map("who_can_change_group_info")
  whoCanDeleteGroup     GroupPermissionLevel? @map("who_can_delete_group")
  whoCanLeaveGroup      GroupPermissionLevel? @map("who_can_leave_group")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("conversation_group_settings")
}

/// Una entrada por dispositivo/navegador suscripto a Web Push (no por usuario:
/// la misma persona puede tener el celular y la notebook suscriptos a la vez).
/// `endpoint` identifica de forma única al service worker de ESE navegador en
/// ESE dispositivo — es la clave natural, no `userId`. Ver push/README.md.
model PushSubscription {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  /// Claves públicas del suscriptor (`PushSubscriptionJSON.keys`), necesarias
  /// para cifrar el payload — ver `web-push`, RFC 8291.
  p256dh   String
  auth     String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

/// Estado de una sesión de subida chunked. Efímera: se crea al iniciar, muere
/// al completar/abortar/expirar. NUNCA es la fuente de verdad de qué partes
/// llegaron — eso lo responde ListParts contra el storage (ver LARGE_FILES_PLAN.md §5.3).
enum FileUploadStatus {
  PENDING   @map("pending") // creada, sin partes todavía
  UPLOADING @map("uploading") // al menos un part-urls pedido
  COMPLETED @map("completed") // Complete OK + StoredFile creado
  ABORTED   @map("aborted") // cancelada por el usuario
  EXPIRED   @map("expired") // barrida por upload-cleanup.worker
  FAILED    @map("failed") // complete rechazado (tamaño real > límite)

  @@map("file_upload_status")
}

model FileUpload {
  id String @id @default(uuid())

  provider         FileProvider
  /// Key generada SIEMPRE por Link, nunca propuesta por el cliente.
  objectKey        String       @map("object_key")
  /// uploadId del CreateMultipartUpload. Null hasta crearlo.
  externalUploadId String?      @map("external_upload_id")

  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  extension    String
  /// Tamaño DECLARADO por el cliente. Solo sirve para rechazar temprano y
  /// calcular totalParts. El real se verifica con HeadObject al completar.
  declaredSize BigInt @map("declared_size")
  partSize     Int    @map("part_size")
  totalParts   Int    @map("total_parts")

  status FileUploadStatus @default(PENDING)

  /// SHA-256 que el cliente calcula incrementalmente. Ayuda de integridad,
  /// NO control de seguridad (lo declara el cliente). Ver §9.3.
  clientChecksum String? @map("client_checksum")

  createdById String @map("created_by_id")
  createdBy   User   @relation("FileUploadCreatedBy", fields: [createdById], references: [id])

  /// Solo namespacing + chequeo de membresía, igual que POST /v1/files.
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  /// Se puebla al completar.
  storedFileId String?     @unique @map("stored_file_id")
  storedFile   StoredFile? @relation(fields: [storedFileId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiresAt DateTime  @map("expires_at")
  closedAt  DateTime? @map("closed_at")

  /// El sweeper barre por (status, expiresAt) — sin este índice hace full scan.
  @@index([status, expiresAt])
  @@index([createdById, status])
  @@map("file_uploads")
}

/// Registro histórico y de estado de una llamada o videollamada.
model Call {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  callerId String @map("caller_id")
  caller   User   @relation("CallCaller", fields: [callerId], references: [id])

  receiverId String @map("receiver_id")
  receiver   User   @relation("CallReceiver", fields: [receiverId], references: [id])

  type   CallType   @default(AUDIO)
  status CallStatus @default(RINGING)

  startedAt  DateTime  @default(now()) @map("started_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")
  duration   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId, createdAt])
  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
  @@map("calls")
}
