# Variables para `docker compose` (copiar este archivo a `.env`, en la raíz del repo).
# Para correr sin Docker, ver backend/.env.example y frontend/.env.example.

# --- PostgreSQL (contenedor) ---
POSTGRES_USER=link
POSTGRES_PASSWORD=change-me
POSTGRES_DB=link

# --- Autenticación (ver README.md, sección "Autenticación") ---
# Modo external-auth: definir las tres EXTERNAL_AUTH_*. Modo local: dejarlas vacías y definir
# LOCAL_AUTH_JWT_SECRET (32 caracteres o más). Generar un secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EXTERNAL_AUTH_API_URL=
APP_CODE_EXTERNAL_AUTH=
EXTERNAL_AUTH_JWT_SECRET=
LOCAL_AUTH_JWT_SECRET=

# --- Web Push (obligatorias) ---
# Generar un par de claves con:
#   npx web-push generate-vapid-keys
# o, sin Node instalado:
#   docker run --rm node:24-bookworm-slim npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https: de contacto, requerido por la spec de Web Push.
VAPID_SUBJECT=mailto:admin@example.com

# --- Opcionales ---
# Secreto para firmar URLs de archivos. Sin definir, se usa el secreto JWT del modo activo.
FILE_URL_SIGNING_SECRET=
# GIFs/stickers vía GIPHY. Sin definir quedan deshabilitados. Antes de activarlos, leer
# backend/src/modules/giphy/README.md ("Requisitos de GIPHY").
GIPHY_API_KEY=
# Origen del frontend permitido por la API y el socket. Obligatoria: la imagen del
# backend corre con NODE_ENV=production. "*" acepta cualquier origen, a propósito.
CORS_ORIGIN=http://localhost:3000
# Reverse proxy delante del backend (ver SECURITY.md): 1 = un proxy (default),
# 2 = dos encadenados, false = backend expuesto directo.
TRUST_PROXY=1
# true solo si TODO el tráfico entra por Cloudflare (usa CF-Connecting-IP como IP del cliente).
TRUST_CF_CONNECTING_IP=false
# URLs con las que el NAVEGADOR llega a la API (se embeben en el build del frontend).
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_SOCKET_URL=http://localhost:4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
LOG_LEVEL=info
